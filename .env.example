APP_NAME="TRON USDT Payment Gateway"
ENVIRONMENT=development
API_PREFIX=/api
HTTPS_ONLY=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_gateway

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15

# Generate a 32-byte key then base64 encode: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY_B64=

TRON_NETWORK=nile
TRON_FULLNODE_URL=https://nile.trongrid.io
TRON_SOLIDITY_URL=https://nile.trongrid.io
TRON_EVENT_URL=https://nile.trongrid.io
TRON_CONFIRMATION_BLOCKS=20

USDT_CONTRACT_MAINNET=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
USDT_CONTRACT_NILE=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj

# Hot wallet mnemonic should be encrypted using AES-256-GCM via encrypt_secret.
HOT_WALLET_MASTER_ENCRYPTED=
HOT_WALLET_XPUB=
COLD_WALLET_ADDRESS=

WEBHOOK_SECRET=change-me
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
